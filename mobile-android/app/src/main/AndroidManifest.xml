<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos de Red -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permisos de Localización Geoespacial Obligatorios -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Permisos de Ejecución en Primer Plano (Android 9+ / Android 14+) y Notificaciones (Android 13+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_dialog_map"
        android:label="ROUTRACK"
        android:roundIcon="@android:drawable/ic_dialog_map"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Actividad Principal (Punto de Entrada en Compose) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Servicio Oficial en Primer Plano para Rastreo de Ubicación y Auditoría Criptográfica -->
        <service
            android:name=".service.LocationForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Servicio en Primer Plano con Captura Adaptativa y Reconocimiento de Actividad (TASK-010) -->
        <service
            android:name="com.routrack.mobile.services.TrackingForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Receptor de Transiciones de Actividad Física (Quieto, Caminando, En Vehículo) -->
        <receiver
            android:name="com.routrack.mobile.services.ActivityTransitionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.routrack.mobile.ACTION_ACTIVITY_TRANSITION" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
