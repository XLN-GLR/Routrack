# ==============================================================================
# ROUTRACK — .gitignore Unificado para Monorepo (Android + Next.js + Supabase)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Variables de Entorno y Secretos (CRÍTICO)
# ------------------------------------------------------------------------------
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.pfx
*.pkcs12
*.crt
*.cert
*.jks
*.keystore

# ------------------------------------------------------------------------------
# 2. Node.js, Next.js y TypeScript (web-admin)
# ------------------------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Logs de gestores de paquetes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Android y Gradle (mobile-android)
# ------------------------------------------------------------------------------
.gradle/
**/build/
captures/
.externalNativeBuild/
.cxx/
local.properties

# Archivos de empaquetado y compilación Android
*.apk
*.ap_
*.aab
*.dex
*.class

# ProGuard / R8 outputs
proguard/
**/proguard-rules.pro.map

# ------------------------------------------------------------------------------
# 4. Entornos de Desarrollo e IDEs
# ------------------------------------------------------------------------------
# IntelliJ / Android Studio
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Antigravity / Gemini local cache
.gemini/cache/
.gemini/logs/

# ------------------------------------------------------------------------------
# 5. Pruebas y Cobertura (Playwright, Jest, JUnit)
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ------------------------------------------------------------------------------
# 6. Supabase Local
# ------------------------------------------------------------------------------
supabase/.temp/
supabase/.branches/

# ------------------------------------------------------------------------------
# 7. Archivos de Sistema Operativo y Temporales
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak
*.swp
*~
