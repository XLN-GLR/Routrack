# ==============================================================================
# ROUTRACK — Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# IMPORTANTE:
# - Copie este archivo como `.env.local` en `apps/web/` o `.env` según corresponda.
# - NUNCA confirme credenciales, tokens reales ni contraseñas en Git.
# - Los valores mostrados a continuación son ejemplos ficticios y descriptivos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEXT.JS WEB APPLICATION (apps/web)
# ------------------------------------------------------------------------------
# URL base de la aplicación web en entorno local o de producción
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# URL pública del proyecto Supabase (segura para exponer en el navegador)
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto-id.supabase.co"

# Clave anónima pública de Supabase (sujeta estrictamente a políticas RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_anon_public_key_solo_para_cliente.firma"

# URL del proveedor de teselas (tiles) para mapas Leaflet
# Opciones estándar: OpenStreetMap, CartoDB Positron, etc.
NEXT_PUBLIC_MAP_TILE_PROVIDER_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"

# ------------------------------------------------------------------------------
# 2. SUPABASE BACKEND & SERVICIOS DE SERVIDOR (Servidor / Edge Functions)
# ------------------------------------------------------------------------------
# Clave de rol de servicio (SERVICE_ROLE_KEY)
# ATENCIÓN: Esta clave salta todas las políticas RLS. 
# NUNCA DEBE INCLUIRSE EN EL CLIENTE WEB NI EN LA APP ANDROID.
# Solo permitida en entornos de servidor aislados o migraciones de mantenimiento.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_service_role_key_nunca_exponer_en_cliente.firma"

# Secreto JWT para validación y firma de tokens en backend
SUPABASE_JWT_SECRET="tu-secreto-jwt-aleatorio-minimo-32-caracteres"

# Contraseña de la base de datos PostgreSQL local o remota (solo para Supabase CLI)
SUPABASE_DB_PASSWORD="tu_password_segura_de_base_de_datos"

# Puerto local del API Gateway de Supabase (por defecto 54321)
SUPABASE_LOCAL_PORT="54321"

# ------------------------------------------------------------------------------
# 3. APLICACIÓN MÓVIL ANDROID (apps/android - BuildConfig / Gradle properties)
# ------------------------------------------------------------------------------
# Endpoint de conexión al backend de Supabase para la app móvil
ROUTRACK_ANDROID_SUPABASE_URL="https://tu-proyecto-id.supabase.co"

# Clave anónima pública para la app Android (opera bajo RLS)
ROUTRACK_ANDROID_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_anon_public_key_para_android.firma"

# Alias para la llave criptográfica en Android Keystore
ROUTRACK_KEYSTORE_ALIAS="RoutrackSessionMasterKey"

# Intervalo predeterminado de telemetría GPS en segundos (ej. 180 segundos = 3 minutos)
ROUTRACK_LOCATION_INTERVAL_SECONDS="180"

# Umbral de desplazamiento mínimo en metros para captura de ubicación
ROUTRACK_LOCATION_SMALLEST_DISPLACEMENT_METERS="50"

# ------------------------------------------------------------------------------
# 4. SERVICIOS EXTERNOS FUTUROS (Opcionales / Fases posteriores)
# ------------------------------------------------------------------------------
# Token de acceso para Mapbox (en caso de alternar a tiles vectoriales de Mapbox)
# MAPBOX_ACCESS_TOKEN="pk.eyJ1IjoiZWplbXBsbyIsImEiOiJjbGVqZW1wbG8wMDAwMCJ9.ejemplo_token"

# DSN de Sentry para reporte y monitoreo de errores en frontend y backend
# SENTRY_DSN="https://ejemploPublicKey@o000000.ingest.sentry.io/0000000"

# Servicio de geocodificación inversa (Nominatim / Google Geocoding API)
# GEOCODING_API_KEY="tu_geocoding_api_key_opcional"
